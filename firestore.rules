rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Remplacer VOTRE_UID_FIREBASE par l’UID du compte propriétaire.
    // Ne pas publier ces règles sans cette substitution.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid == 'VOTRE_UID_FIREBASE';
    }
  }
}
